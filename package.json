{
	"name": "georgy-cv",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"generate:cv-pdf": "node scripts/generate-cv-pdf.mjs",
		"check:cv-pdf": "node scripts/check-cv-pdf.mjs",
		"build": "npm run check:cv-pdf && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.2.2",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@tailwindcss/vite": "^4.3.4",
		"playwright": "^1.56.1",
		"sass": "^1.77.6",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwindcss": "^4.3.4",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.2",
		"svelte-icons": "^2.1.0"
	}
}
